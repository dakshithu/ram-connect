# Multi-stage Dockerfile for cross-compiling macOS & Linux binaries
FROM rust:1.75 as builder

# Install macOS cross-compilation target toolchains
RUN rustup target add aarch64-apple-darwin x86_64-apple-darwin x86_64-unknown-linux-musl

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src

# Build for macOS target if osxcross linker is present, or default static linux
RUN cargo check --target aarch64-apple-darwin --bins
RUN cargo check --target x86_64-apple-darwin --bins

FROM alpine:latest
WORKDIR /dist
COPY --from=builder /app/src /dist/src
CMD ["echo", "macOS target check verified"]
